{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/xpressmike/pet-food-safety/schema/items.schema.json",
 "title": "pet-food-safety dataset",
 "type": "object",
 "required": ["meta", "items"],
 "properties": {
  "meta": {
   "type": "object",
   "required": ["name", "version", "license", "attribution", "reviewed_by", "last_review"],
   "properties": {
    "name": { "type": "string" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "license": { "const": "CC-BY-4.0" },
    "attribution": { "type": "string" },
    "reviewed_by": { "type": "string" },
    "last_review": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" }
   }
  },
  "items": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": ["id", "category", "names", "verdicts", "notes", "sources"],
    "additionalProperties": false,
    "properties": {
     "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
     "category": { "enum": ["food", "plant"] },
     "names": {
      "type": "object",
      "required": ["en", "ru"],
      "properties": {
       "en": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 2 } },
       "ru": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 2 } }
      }
     },
     "scientific_name": { "type": "string" },
     "verdicts": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
       "dog": { "enum": ["safe", "caution", "danger"] },
       "cat": { "enum": ["safe", "caution", "danger"] },
       "rabbit_rodent": { "enum": ["safe", "caution", "danger"] },
       "bird": { "enum": ["safe", "caution", "danger"] },
       "reptile": { "enum": ["safe", "caution", "danger"] },
       "ferret": { "enum": ["safe", "caution", "danger"] }
      }
     },
     "toxin": { "type": "string", "minLength": 3 },
     "notes": {
      "type": "object",
      "required": ["en", "ru"],
      "properties": {
       "en": { "type": "string", "minLength": 20 },
       "ru": { "type": "string", "minLength": 20 }
      }
     },
     "sources": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^https://" } }
    }
   }
  }
 }
}
